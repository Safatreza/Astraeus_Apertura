{
  "mission_name": "ATLAS-III",
  "version": "1.0",
  "requirements": [
    {
      "id": "REQ-MIS-001",
      "category": "functional",
      "statement": "The ATLAS-III system shall detect debris objects with radar cross-section greater than or equal to 10cm² at ranges up to 500km.",
      "rationale": "Primary mission objective for space situational awareness",
      "verification_method": "test",
      "allocation_target": ["PBS-1.1", "PBS-1.1.1", "PBS-1.1.2"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Mission Objectives"
    },
    {
      "id": "REQ-MIS-002",
      "category": "functional",
      "statement": "The system shall operate the radar payload in X-band frequency range (9.5-10.5 GHz).",
      "rationale": "X-band provides optimal balance of range resolution and atmospheric propagation",
      "verification_method": "test",
      "allocation_target": ["PBS-1.1.1", "PBS-1.1.2"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Payload Requirements"
    },
    {
      "id": "REQ-MIS-003",
      "category": "functional",
      "statement": "The system shall perform onboard signal processing for real-time debris detection.",
      "rationale": "Reduces data downlink volume and enables timely alerts",
      "verification_method": "demonstration",
      "allocation_target": ["PBS-1.2", "PBS-1.2.1", "PBS-1.2.2"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Payload Requirements"
    },
    {
      "id": "REQ-MIS-004",
      "category": "interface",
      "statement": "The system shall downlink observation data via the S-band TT&C subsystem.",
      "rationale": "Leverages existing spacecraft communication capability",
      "verification_method": "test",
      "allocation_target": ["PBS-2.4", "PBS-1.3.3"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Interface Requirements"
    },
    {
      "id": "REQ-PF-001",
      "category": "performance",
      "statement": "The system shall achieve a debris detection probability of at least 0.95 for objects meeting the minimum RCS requirement.",
      "rationale": "High detection probability essential for mission success",
      "verification_method": "analysis",
      "allocation_target": ["PBS-1.1", "PBS-1.2"],
      "parent_id": "REQ-MIS-001",
      "priority": 1,
      "status": "approved",
      "source": "KPIs"
    },
    {
      "id": "REQ-PF-002",
      "category": "performance",
      "statement": "The system shall maintain a false alarm rate of less than 0.01 per observation pass.",
      "rationale": "Low false alarm rate ensures actionable detection reports",
      "verification_method": "analysis",
      "allocation_target": ["PBS-1.2.1", "PBS-1.2.2"],
      "parent_id": "REQ-MIS-001",
      "priority": 1,
      "status": "approved",
      "source": "KPIs"
    },
    {
      "id": "REQ-PF-003",
      "category": "performance",
      "statement": "The system shall provide target tracking accuracy of 100m in position and 10m/s in velocity.",
      "rationale": "Required for conjunction assessment calculations",
      "verification_method": "test",
      "allocation_target": ["PBS-1.1", "PBS-1.2.1"],
      "parent_id": "REQ-MIS-001",
      "priority": 2,
      "status": "approved",
      "source": "Payload Requirements"
    },
    {
      "id": "REQ-PF-004",
      "category": "performance",
      "statement": "The system shall support a minimum data rate of 100 Mbps for internal payload data transfer.",
      "rationale": "Required to handle raw radar data throughput",
      "verification_method": "test",
      "allocation_target": ["PBS-1.2.3", "PBS-1.3.3"],
      "parent_id": null,
      "priority": 2,
      "status": "approved",
      "source": "System Constraints"
    },
    {
      "id": "REQ-CN-001",
      "category": "constraint",
      "statement": "The system shall have a total mass not exceeding 12 kg.",
      "rationale": "6U CubeSat mass limit",
      "verification_method": "test",
      "allocation_target": ["PBS-0"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "System Constraints"
    },
    {
      "id": "REQ-CN-002",
      "category": "constraint",
      "statement": "The system shall operate within a power budget of 40 W orbital average.",
      "rationale": "6U CubeSat power generation limit",
      "verification_method": "analysis",
      "allocation_target": ["PBS-2.2"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "System Constraints"
    },
    {
      "id": "REQ-CN-003",
      "category": "constraint",
      "statement": "The system shall conform to 6U CubeSat form factor specifications per CubeSat Design Specification.",
      "rationale": "Launch vehicle compatibility",
      "verification_method": "inspection",
      "allocation_target": ["PBS-2.1", "PBS-1.3.1"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "System Constraints"
    },
    {
      "id": "REQ-OP-001",
      "category": "operational",
      "statement": "The system shall support autonomous operation for up to 48 hours without ground contact.",
      "rationale": "Contingency for ground station outages",
      "verification_method": "demonstration",
      "allocation_target": ["PBS-2.5", "PBS-1.2.1"],
      "parent_id": null,
      "priority": 2,
      "status": "approved",
      "source": "Operational Requirements"
    },
    {
      "id": "REQ-OP-002",
      "category": "operational",
      "statement": "The system shall execute a minimum of 4 radar observation passes per day.",
      "rationale": "Required observation cadence for mission objectives",
      "verification_method": "analysis",
      "allocation_target": ["PBS-1.0", "PBS-2.2"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Payload Requirements"
    },
    {
      "id": "REQ-OP-003",
      "category": "operational",
      "statement": "The system shall limit payload duty cycle to 20% maximum.",
      "rationale": "Thermal and power constraints",
      "verification_method": "analysis",
      "allocation_target": ["PBS-1.0", "PBS-2.6"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Operational Requirements"
    },
    {
      "id": "REQ-EN-001",
      "category": "environmental",
      "statement": "The system shall operate in the LEO radiation environment for a minimum mission lifetime of 24 months.",
      "rationale": "Mission duration requirement",
      "verification_method": "analysis",
      "allocation_target": ["PBS-0"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Environmental Requirements"
    },
    {
      "id": "REQ-EN-002",
      "category": "environmental",
      "statement": "The system shall operate within a thermal range of -20°C to +50°C.",
      "rationale": "LEO thermal environment survival",
      "verification_method": "test",
      "allocation_target": ["PBS-2.6", "PBS-1.3.4"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Environmental Requirements"
    },
    {
      "id": "REQ-IF-001",
      "category": "interface",
      "statement": "The payload shall interface with the spacecraft bus via 28V unregulated power bus.",
      "rationale": "Standard CubeSat power interface",
      "verification_method": "inspection",
      "allocation_target": ["PBS-1.3.2", "PBS-2.2"],
      "parent_id": null,
      "priority": 1,
      "status": "approved",
      "source": "Interface Requirements"
    },
    {
      "id": "REQ-IF-002",
      "category": "interface",
      "statement": "The payload shall interface with the spacecraft OBC via SpaceWire or CAN bus.",
      "rationale": "Standard spacecraft data interfaces",
      "verification_method": "test",
      "allocation_target": ["PBS-1.3.3", "PBS-2.5"],
      "parent_id": null,
      "priority": 2,
      "status": "approved",
      "source": "Interface Requirements"
    },
    {
      "id": "REQ-ST-001",
      "category": "functional",
      "statement": "The system shall provide onboard data storage for minimum 24 hours of observation data.",
      "rationale": "Buffer for ground contact gaps",
      "verification_method": "analysis",
      "allocation_target": ["PBS-1.2.3"],
      "parent_id": null,
      "priority": 2,
      "status": "approved",
      "source": "Operational Requirements"
    }
  ]
}
