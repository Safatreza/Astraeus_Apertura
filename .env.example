# Environment Configuration Template for Astraeus Apertura
# Copy this file to .env and fill in your actual values

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false

# =============================================================================
# API Keys (Required for LLM Integration)
# =============================================================================
# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get your Notion API key from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default for development)
DATABASE_URL=sqlite:///astraeus.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/astraeus

# Redis (optional, for caching and job queues)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
S3_BUCKET=astraeus-data-bucket

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/astraeus.log

# =============================================================================
# Worker Configuration
# =============================================================================
WORKER_THREADS=4  # Number of parallel worker threads
MAX_MEMORY_MB=4096  # Maximum memory per worker

# =============================================================================
# Dashboard Configuration
# =============================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050

# =============================================================================
# ANSYS Configuration
# =============================================================================
ANSYS_VERSION=2024.1
ANSYS_NON_GRAPHICAL=true

# =============================================================================
# Security (Production Only)
# =============================================================================
# SECRET_KEY=your-secret-key-here  # For session encryption
# ALLOWED_HOSTS=yourdomain.com,*.yourdomain.com

# =============================================================================
# Monitoring (Optional)
# =============================================================================
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# =============================================================================
# HPC Configuration (Optional)
# =============================================================================
# HPC_SCHEDULER=slurm  # Options: slurm, pbs, local
# HPC_PARTITION=compute
# HPC_ACCOUNT=your-hpc-account
